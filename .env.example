# ==========================================
# SIMA - Variables de Entorno de Ejemplo
# ==========================================

# Puerto en el que correra el servidor backend
PORT=5000

# URI de conexion a MongoDB (utilizado en el entrypoint y la mayoria de scripts)
MONGO_URI=mongodb://localhost:27017/sima_db

# URI alternativa de conexion (utilizada en algunos scripts auxiliares y backups)
MONGODB_URI=mongodb://localhost:27017/sima_db

# Secreto criptografico para la firma y verificacion de JSON Web Tokens (JWT)
JWT_SECRET=tu_secreto_seguro_aqui_para_produccion

# Entorno de ejecucion (development | production | test)
NODE_ENV=development
