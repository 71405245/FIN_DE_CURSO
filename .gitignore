# ==========================================
# SIMA - Configuración de Gitignore
# ==========================================

# Dependencias de Node.js
node_modules/
**/node_modules/

# Archivos de configuración y secretos (Variables de entorno)
.env
**/.env
!.env.example

# Carpetas de distribución y empaquetado (Build/Dist)
frontend/dist/
frontend/build/
backend/dist/

# Archivos de análisis y reportes de SonarQube
.scannerwork/
**/.scannerwork/

# Respaldos de bases de datos locales
otros/sima_db_backup/
**/sima_db_backup/
backend/sima_db_backup/

# Reportes de pruebas E2E generados localmente
frontend/playwright-report/
frontend/test-results/
frontend/cypress/screenshots/
frontend/cypress/videos/

# Archivos de cobertura de pruebas
coverage/
**/coverage/

# Logs del sistema y runtime
*.log
logs/
**/logs/

# Archivos temporales y de sistema operativo / editores
.DS_Store
[Dd]esktop.ini
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# Archivos de backup de código fuente
*.backup
server.js.backup

# Archivos Markdown de trabajo pendiente (borradores internos)
docs/cierre/PENDIENTE_*.md
