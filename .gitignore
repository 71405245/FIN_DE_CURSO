# ==========================================
# SIMA - Configuración de Gitignore
# ==========================================

# Dependencias de Node.js
node_modules/
**/node_modules/

# Archivos de configuración y secretos (Variables de entorno)
.env
**/.env
!.env.example

# Carpetas de distribución y empaquetado (Build/Dist)
frontend/dist/
frontend/build/
backend/dist/

# Archivos de análisis y reportes de SonarQube
.scannerwork/
**/.scannerwork/
frontend/.scannerwork/
backend/.scannerwork/

# Respaldos de bases de datos locales (excluidos por Green Code y políticas de Git)
otros/sima_db_backup/
**/sima_db_backup/

# Logs del sistema y runtime
*.log
logs/
**/logs/
coverage/
**/coverage/

# Archivos temporales y de configuración del sistema operativo/editores
.DS_Store
[Dd]esktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
